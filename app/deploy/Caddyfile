# DOMAIN ist die Hauptadresse. REDIRECT_DOMAINS (optional, durch Leerzeichen getrennt) sind weitere
# Adressen wie www.DOMAIN oder die frühere sslip.io-Adresse. Caddy holt auch für sie Zertifikate und
# leitet dauerhaft auf DOMAIN um. Ist REDIRECT_DOMAINS leer (z. B. lokal), leitet nichts um.
{$DOMAIN} {$REDIRECT_DOMAINS} {
	@umleiten {
		not host {$DOMAIN}
		expression `"{$REDIRECT_DOMAINS}" != ""`
	}
	redir @umleiten https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy backend:8080
	}

	log {
		output file /data/logs/access.log {
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}
