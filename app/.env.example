# Vorlage für .env auf dem Server. Keine echten Werte einchecken.

# Domain der Webseite, Caddy holt dafür automatisch ein Zertifikat
DOMAIN=ki.example.de

# Präfix des Image-Namens (${REGISTRY}/ki-web:${VERSION}). Die Images werden auf dem Server gebaut.
REGISTRY=ghcr.io/marvinjakob

# Setzt deploy/deploy.sh: laufende und vorherige Version (kurzer Commit-Hash)
VERSION=
PREVIOUS_VERSION=


# Sicherung mit restic in Hetzner Object Storage
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/ki-web-backup
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HEARTBEAT_URL=

# Nur für die lokale Entwicklung ohne Docker (Standardwerte in Klammern)
# ADDR=:8080
# DATABASE_PATH=data/app.db
# MEDIA_PATH=data/media
# PUBLIC_BASE_URL=http://localhost:8080
# DEV_SEED=true        Testbeiträge einspielen
# SERVE_MEDIA=true     /media/* ohne Caddy direkt aus MEDIA_PATH ausliefern
# TRUST_PROXY=true     IP-Adresse aus X-Forwarded-For lesen (nur hinter Caddy, in compose.yaml gesetzt)
